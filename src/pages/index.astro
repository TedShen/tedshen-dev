---
// dev.tedshen.link 首頁：軟體接案與技術顧問。
// 流量來源：名片、社群簡介、搜尋、合作夥伴轉介。目的是讓對方快速確認「是這個人」，然後知道下一步怎麼聯絡。
// CTA 以 LINE 為主，Email 為輔；財務教練那條線在 grow，這頁不混。
import Base from '../layouts/Base.astro';
import OfficialChannels from '../components/OfficialChannels.astro';
import { getPublished, entryPath } from '../lib/sections';
import { EMAIL, LINE_URL, SITE_URL, SITE_DESCRIPTION, HUB_URL, GROW_URL, RESUME_URL, KINDMAP_URL, PERSON } from '../consts';

const abs = (p: string) => new URL(p, SITE_URL).href;
const works = await getPublished('works');
const featured = works.slice(0, 3);
const mailto = `mailto:${EMAIL}?subject=${encodeURIComponent('軟體合作洽詢')}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': abs('/#service'),
  name: '軟體開發與技術顧問',
  description: SITE_DESCRIPTION,
  serviceType: ['自動化設備軟體', '系統串接與流程自動化', '網站與前端開發', '技術顧問與研究分析'],
  provider: { '@type': 'Person', '@id': `${HUB_URL}/#person`, name: PERSON.name, url: HUB_URL },
  areaServed: '台灣',
  availableLanguage: ['zh-Hant'],
  url: abs('/'),
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': abs('/#website'),
  name: '沈裕德 Ted ｜ 軟體開發',
  url: abs('/'),
  description: SITE_DESCRIPTION,
  inLanguage: 'zh-Hant',
  author: { '@id': `${HUB_URL}/#person` },
};
---

<Base
  title="軟體開發與技術顧問 ｜ 沈裕德 Ted"
  description={SITE_DESCRIPTION}
  ogTitle="軟體開發與技術顧問 ｜ Ted"
  ogDescription="15 年資歷的軟體工程師。自動化設備軟體、系統串接、網站開發、技術顧問。先把需求講清楚，再談怎麼做。"
  path="/"
  schema={[serviceSchema, websiteSchema]}
>
  <!-- ① 頂部導覽＋Hero（深色） -->
  <div class="dark-band">
    <nav class="top-nav wrap-wide" aria-label="主要導覽">
      <a class="top-brand" href="/"><span class="mono accent" aria-hidden="true">&lt;/&gt;</span>Ted ｜ 軟體開發</a>
      <ul>
        <li><a href="/services/">服務</a></li>
        <li><a href="/works/">作品</a></li>
        <li><a href="/notes/">技術筆記</a></li>
        <li><a class="nav-line" href={LINE_URL}>加 LINE 聊一聊</a></li>
      </ul>
    </nav>

    <header class="hero2 wrap-wide">
      <div class="hero2-text">
        <p class="eyebrow mono accent">DEV ｜ 軟體開發與技術顧問</p>
        <h1>把你想做的事<br />變成能跑的系統</h1>
        <p class="hero2-lead">
          我是沈裕德 Ted，軟體工程師，15 年資歷。軟體開發、機器視覺、工業自動化、系統串接、網站，技術顧問。
        </p>
        <div class="btn-row">
          <a class="btn btn-line" href={LINE_URL}>加 LINE 聊一聊 →</a>
          <a class="btn btn-outline-dark" href="/works/">看作品與 Demo</a>
        </div>
        <div class="hero2-me">
          <picture>
            <source srcset="/avatar.webp" type="image/webp" />
            <img class="avatar-sm" src="/avatar.jpg" alt={`${PERSON.name} ${PERSON.alternateName}，軟體工程師`} width="48" height="48" fetchpriority="high" />
          </picture>
          <span>沈裕德 Ted ・ 中央大學資工碩士</span>
        </div>
      </div>

      <a class="status-card" href="/demos/dg1-measurement/" aria-label="開啟 DG-1 示範量測機 Demo">
        <div class="status-head">
          <div><strong>DG-1 示範量測機</strong><span>線上輪廓量測・狀態畫面</span></div>
          <span class="badge-sim">只用模擬驗證</span>
        </div>
        <div class="status-ok"><span class="dot" aria-hidden="true"></span>可以量測</div>
        <div class="status-grid">
          <div><span>溫區 T1</span><b class="mono">35.88</b></div>
          <div><span>溫區 T2</span><b class="mono">35.88</b></div>
          <div><span>溫區 T3</span><b class="mono">35.90</b></div>
          <div><span>溫區 T4</span><b class="mono">35.93</b></div>
        </div>
        <div class="status-flow">
          <span>感測頭 ✓</span><i aria-hidden="true">→</i><span>擷取 ✓</span><i aria-hidden="true">→</i><span>拼接運算 ✓</span><i aria-hidden="true">→</i><span>PLC 回送 ✓</span>
        </div>
        <p class="status-note">作品 Demo 畫面，機台、數值、名稱皆為虛構 ・ 點開試用 →</p>
      </a>
    </header>
  </div>

  <!-- ② 數字 -->
  <section class="stats-band">
    <div class="wrap-wide stats">
      <div><b>15<small> 年</small></b><span>軟體開發資歷</span></div>
      <div><b>{works.length}<small> 件</small></b><span>公開作品與 Demo</span></div>
      <div><b>5<small> 類</small></b><span>接案經歷（設備、POS、LINE…）</span></div>
      <div><b>126<small> 家</small></b><span>捐前一查收錄公益單位</span></div>
    </div>
  </section>

  <!-- ③ 能做什麼 -->
  <section class="tint">
    <div class="wrap-wide">
      <p class="eyebrow mono">SERVICES ｜ 我能做的事</p>
      <h2 class="h2-big">四種工作，看你的需求落在哪一種</h2>
      <div class="grid-2">
        <div class="card card-white"><div class="num mono">01</div><h3>系統串接與流程自動化</h3><p>把你手上的服務接起來：POS 機串接、LINE 官方帳號建置與串接、SharePoint 串接、報表與資料處理腳本。目標是讓你不用再每週做同一件事。</p></div>
        <div class="card card-white"><div class="num mono">02</div><h3>網站與小型產品</h3><p>形象網站、部落格、內部工具，到一個完整的小型產品。重視載入速度、手機體驗，和搜尋引擎能不能正確讀到你的內容。</p></div>
        <div class="card card-white"><div class="num mono">03</div><h3>自動化設備軟體</h3><p>產線設備的控制軟體、機器視覺量測與檢測、雷射加工自動化。這是我做了 15 年的本業：從演算法、相機校正到現場驗收，整套都經手過。</p></div>
        <div class="card card-white"><div class="num mono">04</div><h3>技術顧問與研究分析</h3><p>不一定要寫程式。幫你看方向、選工具、評估做法和成本、審視外包交付品質，或針對特定設備與技術做研究分析，例如半導體設備。</p></div>
      </div>
      <p style="margin-top:24px;"><a class="btn btn-ghost" href="/services/">看各項服務的詳細說明 →</a></p>
    </div>
  </section>

  <!-- ④ 作品 -->
  <section>
    <div class="wrap-wide">
      <div class="head-row">
        <div>
          <p class="eyebrow mono">WORKS ｜ 作品與 Demo</p>
          <h2 class="h2-big">看得到、點得進去的東西</h2>
        </div>
        <a class="more-link" href="/works/">看全部 {works.length} 件作品 →</a>
      </div>
      <div class="grid-3">
        {featured.map((e) => (
          <a class="card card-link work-card" href={entryPath('works', e.id)}>
            {'cover' in e.data && e.data.cover && (
              <img class="card-cover" src={e.data.cover} alt={e.data.coverAlt ?? e.data.title} width="1200" height="900" loading="lazy" />
            )}
            {'kind' in e.data && <span class="tag">{e.data.kind}</span>}
            <h3>{e.data.shortTitle ?? e.data.title}</h3>
            <p>{e.data.description}</p>
          </a>
        ))}
      </div>
      <div class="grid-2" style="margin-top:20px;">
        <div class="card">
          <h3>捐前一查</h3>
          <p>台灣公益單位查詢平台。收錄 126 家已立案單位，逐筆查證勸募字號與財報揭露。捐款一律導向各單位官方管道，平台不經手款項。</p>
          <p style="margin-top:14px;"><a class="btn btn-ghost" href={KINDMAP_URL}>kindmap.link →</a></p>
        </div>
        <div class="card">
          <h3>完整履歷</h3>
          <p>英文版，含各段經歷、技術清單與研究背景。機器視覺、工業自動化、資安軟體，中央大學資工碩士與太空科學碩士。</p>
          <p style="margin-top:14px;"><a class="btn btn-ghost" href={RESUME_URL}>tedshen.github.io →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑤ 接案經歷 -->
  <section class="tint">
    <div class="wrap-wide split">
      <div class="split-side">
        <p class="eyebrow mono">EXPERIENCE ｜ 接案經歷</p>
        <h2 class="h2-big">做過的案子</h2>
        <p>案子的細節多半有保密約定，能講的範圍我會在第一次聯絡時說清楚。</p>
      </div>
      <ul class="exp-list">
        <li><strong>自動化設備軟體</strong><span>設備控制與量測系統</span></li>
        <li><strong>POS 機串接</strong><span>銷售系統與後端資料整合</span></li>
        <li><strong>LINE 官方帳號</strong><span>建置與功能串接</span></li>
        <li><strong>SharePoint 串接</strong><span>企業文件與流程整合</span></li>
        <li><strong>半導體設備研究分析</strong><span>技術評估與分析報告</span></li>
      </ul>
    </div>
  </section>

  <!-- ⑥ 合作方式 -->
  <section>
    <div class="wrap-wide">
      <p class="eyebrow mono">HOW ｜ 合作方式</p>
      <h2 class="h2-big">大小案子都談，但先講清楚</h2>
      <div class="grid-3">
        <div class="how"><h3>單次專案</h3><p>範圍明確、有交付日期的案子，先報價再開工。</p></div>
        <div class="how"><h3>持續合作</h3><p>固定時數的維護、迭代或兼職開發。</p></div>
        <div class="how"><h3>顧問時段</h3><p>以小時計的技術諮詢，適合評估與決策階段。</p></div>
      </div>
      <p class="zone-note">
        另一條線：我同時也是財務教練。財務、資產或理財的事，入口在
        <a href={`${GROW_URL}/`} style="color:var(--brand-dark);font-weight:600;">grow.tedshen.link</a>；軟體的事在這頁談，兩邊我都不推銷。
      </p>
    </div>
  </section>

  <!-- ⑦ CTA -->
  <section style="padding-top:0;">
    <div class="wrap-wide">
      <div class="cta-dark">
        <div>
          <h2>有想做的東西？</h2>
          <p>第一次聯絡不用準備完整規格。把問題、現在怎麼做、希望變成什麼樣子講清楚，我回你可行的做法。細節談定之後，我會用信件把結論留一份紀錄。</p>
        </div>
        <div class="btn-row">
          <a class="btn btn-line" href={LINE_URL}>加 LINE 聊一聊 →</a>
          <a class="btn btn-outline-dark" href={mailto}>{EMAIL}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ⑧ 官方管道與防冒用 -->
  <OfficialChannels />
</Base>

<style>
  .mono { font-family: ui-monospace, "SF Mono", "JetBrains Mono", Menlo, Consolas, monospace; }
  .dark-band { background: #0b1220; color: #e6edf7; }
  .accent { color: #34d399; }
  .top-nav { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; padding-top: 18px; padding-bottom: 18px; border-bottom: 1px solid #1e293b; }
  .top-brand { color: #e6edf7; text-decoration: none; font-weight: 700; font-size: 1.1rem; display: flex; align-items: center; gap: 10px; }
  .top-nav ul { list-style: none; display: flex; flex-wrap: wrap; align-items: center; gap: 22px; }
  .top-nav a { color: #cbd5e1; text-decoration: none; font-weight: 600; font-size: .95rem; }
  .top-nav a:hover { color: #ffffff; }
  .top-nav a.nav-line { background: var(--line); color: #052e16; padding: 10px 18px; border-radius: 999px; display: inline-flex; min-height: 44px; align-items: center; }

  .hero2 { display: flex; flex-wrap: wrap; align-items: center; gap: 56px; padding-top: 72px; padding-bottom: 88px; }
  .hero2-text { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .eyebrow { font-size: .85rem; letter-spacing: .08em; font-weight: 600; color: var(--brand-dark); margin-bottom: 8px; }
  .hero2 .eyebrow { color: #34d399; margin-bottom: 0; }
  .hero2 h1 { font-size: clamp(2.2rem, 4.6vw, 3.6rem); line-height: 1.18; font-weight: 900; color: #e6edf7; }
  .hero2-lead { font-size: 1.12rem; line-height: 1.8; color: #a9b8cc; }
  .btn-row { display: flex; flex-wrap: wrap; gap: 12px; }
  .btn-line { color: #052e16; }
  .btn-outline-dark { border: 1.5px solid #334155; color: #e6edf7; background: transparent; }
  .hero2-me { display: flex; align-items: center; gap: 12px; color: #a9b8cc; font-size: .92rem; }
  .avatar-sm { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; object-position: center 20%; border: 1px solid #334155; display: block; }

  .status-card { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 16px; background: #111a2e; border: 1px solid #1f2b44; border-radius: 16px; padding: 22px; color: #e6edf7; text-decoration: none; transition: transform .15s ease; }
  .status-card:hover { transform: translateY(-2px); }
  .status-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px; }
  .status-head div { display: flex; flex-direction: column; }
  .status-head span { font-size: .78rem; color: #94a3b8; }
  .status-head .badge-sim { color: #fcd34d; border: 1px solid #a16207; border-radius: 999px; padding: 4px 10px; }
  .status-ok { background: #0f2a1f; border: 1px solid #166534; border-radius: 10px; padding: 14px 16px; display: flex; align-items: center; gap: 10px; font-weight: 700; color: #86efac; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: #34d399; display: inline-block; }
  .status-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
  .status-grid div { background: #0b1220; border: 1px solid #1f2b44; border-radius: 10px; padding: 12px; display: flex; flex-direction: column; }
  .status-grid span { font-size: .78rem; color: #94a3b8; }
  .status-grid b { font-size: 1.5rem; font-weight: 500; }
  .status-flow { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; font-size: .78rem; color: #cbd5e1; }
  .status-flow span { border: 1px solid #166534; border-radius: 6px; padding: 6px 10px; }
  .status-flow i { color: #64748b; font-style: normal; }
  .status-note { font-size: .78rem; color: #94a3b8; }

  .stats-band { padding: 36px 0; border-bottom: 1px solid var(--border); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 150px), 1fr)); gap: 24px; }
  .stats div { display: flex; flex-direction: column; }
  .stats b { font-size: 2.2rem; font-weight: 900; line-height: 1.2; }
  .stats small { font-size: 1.1rem; font-weight: 700; }
  .stats span { color: var(--muted); font-size: .95rem; }

  section { padding: 88px 0; }
  .tint { background: var(--surface); }
  .h2-big { font-size: clamp(1.6rem, 2.6vw, 2.25rem); font-weight: 900; margin-bottom: 32px; line-height: 1.35; }
  .card-white { background: var(--bg); }
  .head-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .more-link { color: var(--brand-dark); font-weight: 700; text-decoration: none; margin-bottom: 32px; }
  .work-card h3 { margin-top: 6px; }

  .split { display: flex; flex-wrap: wrap; gap: 48px; }
  .split-side { flex: 1 1 300px; min-width: 0; }
  .split-side .h2-big { margin-bottom: 14px; }
  .exp-list { flex: 2 1 480px; min-width: 0; list-style: none; }
  .exp-list li { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; padding: 18px 0; border-bottom: 1px solid var(--border); }
  .exp-list li:last-child { border-bottom: 0; }
  .exp-list span { color: var(--muted); }

  .how { border-top: 3px solid var(--brand-dark); padding-top: 18px; }
  .how h3 { font-size: 1.15rem; margin-bottom: 6px; }

  .cta-dark { background: #0b1220; color: #e6edf7; border-radius: 20px; padding: 56px 40px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 28px; }
  .cta-dark > div:first-child { flex: 1 1 420px; min-width: 0; }
  .cta-dark h2 { font-size: clamp(1.6rem, 2.6vw, 2.25rem); font-weight: 900; margin-bottom: 10px; }
  .cta-dark p { color: #a9b8cc; }
  @media (max-width: 560px) {
    .hero2 { padding-top: 48px; padding-bottom: 64px; gap: 40px; }
    section { padding: 64px 0; }
    .cta-dark { padding: 40px 24px; }
  }
</style>
