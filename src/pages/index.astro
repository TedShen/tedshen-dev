---
// dev.tedshen.link 首頁：軟體接案與技術顧問。
// 流量來源：名片、社群簡介、搜尋、合作夥伴轉介。目的是讓對方快速確認「是這個人」，然後知道下一步怎麼聯絡。
// CTA 以 LINE 為主，Email 為輔；財務教練那條線在 grow，這頁不混。
import Base from '../layouts/Base.astro';
import OfficialChannels from '../components/OfficialChannels.astro';
import { EMAIL, LINE_URL, SITE_URL, SITE_DESCRIPTION, HUB_URL, GROW_URL, RESUME_URL, KINDMAP_URL, PERSON } from '../consts';

const abs = (p: string) => new URL(p, SITE_URL).href;
const mailto = `mailto:${EMAIL}?subject=${encodeURIComponent('軟體合作洽詢')}`;

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': abs('/#service'),
  name: '軟體開發與技術顧問',
  description: SITE_DESCRIPTION,
  serviceType: ['自動化設備軟體', '系統串接與流程自動化', '網站與前端開發', '技術顧問與研究分析'],
  provider: { '@type': 'Person', '@id': `${HUB_URL}/#person`, name: PERSON.name, url: HUB_URL },
  areaServed: '台灣',
  availableLanguage: ['zh-Hant'],
  url: abs('/'),
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': abs('/#website'),
  name: '沈裕德 Ted ｜ 軟體開發',
  url: SITE_URL,
  description: SITE_DESCRIPTION,
  inLanguage: 'zh-Hant',
  author: { '@id': `${HUB_URL}/#person` },
};
---

<Base
  title="軟體開發與技術顧問 ｜ 沈裕德 Ted"
  description={SITE_DESCRIPTION}
  ogTitle="軟體開發與技術顧問 ｜ Ted"
  ogDescription="十年以上軟體工程師。自動化設備軟體、系統串接、網站開發、技術顧問。先把需求講清楚，再談怎麼做。"
  path="/"
  schema={[serviceSchema, websiteSchema]}
>
  <!-- ① Hero -->
  <header class="hero wrap">
    <img class="avatar" src="/avatar.jpg" alt={`${PERSON.name} ${PERSON.alternateName}，軟體工程師`} width="96" height="96" />
    <p class="brand-tag">DEV ｜ 軟體開發</p>
    <h1><span class="h1-kicker">軟體開發與技術顧問</span>把你想做的事<br />變成能跑的系統</h1>
    <p class="lead">
      我是沈裕德 Ted，軟體工程師，十年以上。<br />
      軟體開發、機器視覺、工業自動化、系統串接、網站，技術顧問。
    </p>
    <a class="btn btn-line" href={LINE_URL}>加 LINE 聊一聊 →</a>
  </header>

  <!-- ② 能做什麼 -->
  <section class="wrap">
    <p class="zone-label">我能做的事</p>
    <h2>四種工作，看你的需求落在哪一種</h2>
    <div class="cards">
      <div class="card">
        <div class="num">01</div>
        <h3>自動化設備軟體</h3>
        <p>產線設備的控制軟體、機器視覺量測與檢測、雷射加工自動化。這是我做了十年的本業：從演算法、相機校正到現場驗收，整套都經手過。</p>
      </div>
      <div class="card">
        <div class="num">02</div>
        <h3>系統串接與流程自動化</h3>
        <p>把你手上的服務接起來：POS 機串接、LINE 官方帳號建置與串接、SharePoint 串接、報表與資料處理腳本。目標是讓你不用再每週做同一件事。</p>
      </div>
      <div class="card">
        <div class="num">03</div>
        <h3>網站與小型產品</h3>
        <p>形象網站、部落格、內部工具，到一個完整的小型產品。重視載入速度、手機體驗，和搜尋引擎能不能正確讀到你的內容。</p>
      </div>
      <div class="card">
        <div class="num">04</div>
        <h3>技術顧問與研究分析</h3>
        <p>不一定要寫程式。幫你看方向、選工具、評估做法和成本、審視外包交付品質，或針對特定設備與技術做研究分析，例如半導體設備。</p>
      </div>
    </div>
  </section>

  <!-- ③ 做過的案子 -->
  <section class="wrap">
    <p class="zone-label">做過的案子</p>
    <h2>接案經歷</h2>
    <ul class="pill-list">
      <li>自動化設備軟體 — 設備控制與量測系統</li>
      <li>POS 機串接 — 銷售系統與後端資料整合</li>
      <li>LINE 官方帳號 — 建置與功能串接</li>
      <li>SharePoint 串接 — 企業文件與流程整合</li>
      <li>半導體設備研究分析 — 技術評估與分析報告</li>
    </ul>
    <p class="zone-note">
      案子的細節多半有保密約定，能講的範圍我會在第一次聯絡時說清楚。
    </p>
  </section>

  <!-- ④ 作品 -->
  <section class="wrap">
    <p class="zone-label">看得到的東西</p>
    <h2>作品與履歷</h2>
    <div class="cards">
      <div class="card">
        <h3>捐前一查</h3>
        <p>
          台灣公益單位查詢平台。彙整已立案的公益團體、官方捐款管道與使用者評價，資料以政府開放資料為基礎，捐款一律導向各單位官方管道，平台不經手款項。從零到上線的完整產品。
        </p>
        <p style="margin-top:14px;"><a class="btn btn-ghost" href={KINDMAP_URL}>kindmap.link →</a></p>
      </div>
      <div class="card">
        <h3>這幾個網站</h3>
        <p>
          這站、<a href={`${HUB_URL}/`} style="color:var(--brand-dark);font-weight:600;">tedshen.link</a> 和
          <a href={`${GROW_URL}/`} style="color:var(--brand-dark);font-weight:600;">grow.tedshen.link</a>
          都是我用 Astro 做的靜態網站，同一套版型，部署在 GitHub Pages。零客戶端 JavaScript，SEO 照規矩做完，你可以直接看原始碼。
        </p>
      </div>
      <div class="card">
        <h3>完整履歷</h3>
        <p>
          英文版，含各段經歷、技術清單與研究背景。機器視覺、工業自動化、資安軟體，中央大學資工碩士與太空科學碩士。
        </p>
        <p style="margin-top:14px;"><a class="btn btn-ghost" href={RESUME_URL}>tedshen.github.io →</a></p>
      </div>
    </div>
  </section>

  <!-- ⑤ 合作方式 -->
  <section class="wrap">
    <p class="zone-label">合作方式</p>
    <h2>大小案子都談，但先講清楚</h2>
    <ul class="pill-list">
      <li>單次專案 — 範圍明確、有交付日期的案子，先報價再開工</li>
      <li>持續合作 — 固定時數的維護、迭代或兼職開發</li>
      <li>顧問時段 — 以小時計的技術諮詢，適合評估與決策階段</li>
    </ul>
    <p class="zone-note">
      第一次聯絡不用準備完整規格。把你想解決的問題、現在怎麼做、希望變成什麼樣子講清楚就好，我會回你問題和初步的做法。
    </p>
  </section>

  <!-- ⑥ 另一條線 -->
  <section class="wrap">
    <p class="zone-label">另一條線</p>
    <h2>我同時也是財務教練</h2>
    <p class="zone-intro">
      如果你是因為財務、資產或理財的事找到這頁，入口在
      <a href={`${GROW_URL}/`} style="color:var(--brand-dark);font-weight:600;">grow.tedshen.link</a>。
      軟體的事在這頁談，財務的事在那邊談，兩邊我都不推銷。
    </p>
  </section>

  <!-- ⑦ CTA -->
  <section class="wrap">
    <div class="cta">
      <h2>有想做的東西？</h2>
      <p>加 LINE 最快。把問題講清楚，我回你可行的做法。<br />細節談定之後，我會用信件把結論留一份紀錄。</p>
      <a class="btn btn-line" href={LINE_URL}>加 LINE 聊一聊 →</a>
      <p style="margin-top:16px;font-size:.9rem;">
        或寫信：<a href={mailto} style="color:var(--brand-dark);">{EMAIL}</a>
        ・ 確認身分：<a href={`${HUB_URL}/`} style="color:var(--muted);">tedshen.link</a>
      </p>
    </div>
  </section>

  <!-- ⑧ 官方管道與防冒用 -->
  <OfficialChannels />
</Base>
