---
// 三個內容區的內頁。schema 依區塊不同：服務頁 Service、作品 CreativeWork、筆記 TechArticle。
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { SECTIONS, getPublished, entryPath, formatDate, type SectionKey } from '../../lib/sections';
import { SITE_URL, HUB_URL, PERSON, LINE_URL } from '../../consts';

export async function getStaticPaths() {
  const paths = [];
  for (const section of Object.keys(SECTIONS) as SectionKey[]) {
    const items = await getPublished(section);
    for (const entry of items) paths.push({ params: { section, slug: entry.id }, props: { section, entry } });
  }
  return paths;
}

const { section, entry } = Astro.props as { section: SectionKey; entry: any };
const meta = SECTIONS[section];
const { Content } = await render(entry);
const d = entry.data;
const path = entryPath(section, entry.id);
const abs = (p: string) => new URL(p, SITE_URL).href;
const author = { '@type': 'Person', '@id': `${HUB_URL}/#person`, name: PERSON.name, url: HUB_URL };

const schema =
  section === 'services'
    ? {
        '@context': 'https://schema.org',
        '@type': 'Service',
        '@id': abs(`${path}#service`),
        name: d.title,
        description: d.description,
        provider: author,
        areaServed: '台灣',
        availableLanguage: ['zh-Hant'],
        url: abs(path),
      }
    : {
        '@context': 'https://schema.org',
        '@type': section === 'notes' ? 'TechArticle' : 'CreativeWork',
        headline: d.title,
        name: d.title,
        description: d.description,
        author,
        datePublished: d.pubDate.toISOString(),
        dateModified: (d.updated ?? d.pubDate).toISOString(),
        inLanguage: 'zh-Hant',
        url: abs(path),
        mainEntityOfPage: abs(path),
        ...(d.cover ? { image: abs(d.cover) } : {}),
        ...(d.tags?.length ? { keywords: d.tags.join(', ') } : {}),
      };
---

<Base
  title={`${d.shortTitle ?? d.title} ｜ 沈裕德 Ted`}
  description={d.description}
  ogTitle={d.title}
  path={path}
  image={d.image ?? '/og.jpg'}
  type={section === 'services' ? 'website' : 'article'}
  publishedTime={d.pubDate}
  modifiedTime={d.updated ?? d.pubDate}
  breadcrumbs={[{ name: meta.name, path: meta.path }, { name: d.shortTitle ?? d.title, path }]}
  schema={schema}
>
  <SiteNav current={meta.path} />
  {section === 'works' && d.demo ? (
    <section class="demo-view" aria-label={`${d.demoName ?? d.title} 網站 Demo`}>
      <div class="wrap-wide demo-bar">
        <div class="demo-id">
          <span class="zone-label">BRAND SITE ／ 品牌網站 Demo</span>
          <h1>{d.demoName ?? d.title}</h1>
        </div>
        <div class="demo-actions">
          <a class="btn btn-ghost" href={d.demo} target="_blank" rel="noopener">全螢幕開啟 ↗</a>
          <a class="btn btn-line" href={LINE_URL}>做一個你的品牌官網 →</a>
        </div>
      </div>
      <div class="demo-frame">
        <span class="demo-dots" aria-hidden="true"><i></i><i></i><i></i><em class="mono">{new URL(d.demo, SITE_URL).host + d.demo}</em></span>
        <iframe src={d.demo} title={`${d.demoName ?? d.title} 網站 Demo`} loading="eager"></iframe>
      </div>
      <p class="wrap-wide demo-note">
        虛構品牌示範，商品、價格與數據都是編的。{d.credits && `照片來自 Unsplash（可免費商用）：${d.credits}。`}
        <a href={meta.path}>← 回到{meta.name}</a>
      </p>
    </section>
  ) : (
    <>
      <article class="wrap prose page-head entry">
        <p class="zone-label">{meta.label}</p>
        <h1>{d.title}</h1>
        <p class="entry-meta mono">
          {section === 'works' && d.kind && <span class="on">● {d.kind}</span>}
          <span>{d.updated ? `更新於 ${formatDate(d.updated)}` : formatDate(d.pubDate)}</span>
          {d.tags.map((t: string) => <span>#{t}</span>)}
        </p>
        {section === 'works' && d.cover && (
          <figure class="entry-cover"><img src={d.cover} alt={d.coverAlt ?? d.title} width="1200" height="900" /></figure>
        )}
        {section === 'works' && (d.stack?.length || d.link) && (
          <dl class="entry-facts mono">
            {d.stack?.length > 0 && <div><dt>STACK ／ 技術</dt><dd>{d.stack.join(' · ')}</dd></div>}
            {d.link && <div><dt>LINK ／ 連結</dt><dd><a href={d.link}>{d.linkLabel ?? d.link} →</a></dd></div>}
          </dl>
        )}
        <Content />
        <p><a class="back-link" href={meta.path}>← 回到{meta.name}</a></p>
      </article>
      <ContactCTA subject={`洽詢：${d.shortTitle ?? d.title}`} />
    </>
  )}
</Base>
