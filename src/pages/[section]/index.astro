---
// 三個內容區的列表頁：/services/、/works/、/notes/
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { SECTIONS, getPublished, entryPath, formatDate, type SectionKey } from '../../lib/sections';
import { SITE_URL, HUB_URL } from '../../consts';

export async function getStaticPaths() {
  return (Object.keys(SECTIONS) as SectionKey[]).map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionKey;
const meta = SECTIONS[section];
const items0 = await getPublished(section);
// 作品列表：品牌網站 Demo 排在最前面
const items = section === 'works' ? [...items0.filter((e: any) => e.data.demo), ...items0.filter((e: any) => !e.data.demo)] : items0;
const abs = (p: string) => new URL(p, SITE_URL).href;

const listSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': abs(meta.path),
  name: `${meta.title}｜${meta.name}`,
  url: abs(meta.path),
  inLanguage: 'zh-Hant',
  isPartOf: { '@id': abs('/#website') },
  author: { '@id': `${HUB_URL}/#person` },
  hasPart: items.map((e) => ({ '@type': 'CreativeWork', name: e.data.title, url: abs(entryPath(section, e.id)) })),
};
---

<Base
  title={`${meta.title} ｜ 沈裕德 Ted`}
  description={meta.desc}
  path={meta.path}
  breadcrumbs={[{ name: meta.name, path: meta.path }]}
  schema={listSchema}
>
  <SiteNav current={meta.path} />
  <header class="wrap-wide page-head">
    <p class="zone-label">{meta.label}</p>
    <h1>{meta.title}</h1>
    <p class="lead">{meta.intro}</p>
  </header>

  <section class="wrap-wide" style="padding-top:8px;">
    {items.length === 0 ? (
      <p>內容整理中。</p>
    ) : (
      section === 'works' ? (
        <div class="works-grid">
          {items.map((e: any) => (
            <a class="w" href={entryPath(section, e.id)}>
              <div class="w-img">
                {e.data.cover && <img src={e.data.cover} alt={e.data.demo ? '' : (e.data.coverAlt ?? e.data.title)} loading="lazy" />}
                {(e.data.demo || !/^\/works\/cover-.*\.webp$/.test(e.data.cover ?? '')) && <span class="w-kind mono">{e.data.demo ? '品牌網站 Demo' : e.data.kind}</span>}
              </div>
              <div class="w-txt">
                <h3>{e.data.shortTitle ?? e.data.title}</h3>
                <p>{e.data.description}</p>
                {e.data.stack?.length > 0 && <span class="w-stack mono">{e.data.stack.slice(0, 3).join(' · ')}</span>}
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="cards grid-2">
          {items.map((e) => (
            <a class="card card-link" href={entryPath(section, e.id)}>
              <h3>{e.data.shortTitle ?? e.data.title}</h3>
              <p>{e.data.description}</p>
              <p class="post-meta" style="margin:10px 0 0;">{formatDate(e.data.updated ?? e.data.pubDate)}{e.data.tags.length > 0 && ` ・ ${e.data.tags.join('、')}`}</p>
            </a>
          ))}
        </div>
      )
    )}
  </section>

  <ContactCTA />
</Base>
