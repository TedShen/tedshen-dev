---
import { SITE_NAME, SITE_URL, SITE_DESCRIPTION, PERSON, EMAIL } from '../consts';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  /** 相對路徑，例如 "/blog/"。用來組 og:url 與 canonical；沒尾斜線會自動補。 */
  path?: string;
  /** 分享預覽圖，相對路徑；預設 /og.jpg（1200×630）。單篇文章有專圖時可覆寫。 */
  image?: string;
  /** 文章頁傳 'article'，其餘預設 'website'。 */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 麵包屑，不含首頁（會自動加在最前面）。例：[{ name: '部落格', path: '/blog/' }] */
  breadcrumbs?: { name: string; path: string }[];
  /** 額外 JSON-LD（Person、BlogPosting 等），見 src/lib/schema.ts。 */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE_NAME,
  description = SITE_DESCRIPTION,
  ogTitle,
  ogDescription,
  path = '/',
  image = '/og.jpg',
  type = 'website',
  publishedTime,
  modifiedTime,
  breadcrumbs = [],
  schema,
} = Astro.props;

// GitHub Pages 實際服務的是 /path/，沒尾斜線的網址會 301。canonical 必須指向最終網址。
const withSlash = (p: string) => (p.endsWith('/') ? p : `${p}/`);
const canonical = new URL(withSlash(path), SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;

const breadcrumbLd =
  breadcrumbs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ name: '首頁', path: '/' }, ...breadcrumbs].map((b, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: b.name,
          item: new URL(withSlash(b.path), SITE_URL).href,
        })),
      }
    : null;
const schemas = [
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
  ...(breadcrumbLd ? [breadcrumbLd] : []),
];
---

<!DOCTYPE html>
<html lang="zh-Hant">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0D0F12" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph：分享到 LINE / FB 時的預覽 -->
    <meta property="og:title" content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {image === '/og.jpg' && (
      <>
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
      </>
    )}
    <meta property="og:image:alt" content={`${PERSON.name} ${PERSON.alternateName}，${PERSON.jobTitle}`} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="zh_TW" />
    {type === 'article' && publishedTime && (
      <meta property="article:published_time" content={publishedTime.toISOString()} />
    )}
    {type === 'article' && modifiedTime && (
      <meta property="article:modified_time" content={modifiedTime.toISOString()} />
    )}
    {type === 'article' && <meta property="article:author" content={PERSON.name} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle ?? title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${PERSON.name} ${PERSON.alternateName}，${PERSON.jobTitle}`} />

    <!-- 結構化資料：Person / WebSite / BlogPosting / BreadcrumbList，由各頁透過 props 傳入 -->
    {schemas.map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@600;800&family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+TC:wght@400;500;700;900&display=swap" />
    <style is:global>
      :root {
        /* 2026-11-03 改版：深色儀器風（量測機台的石墨外殼＋紅色線雷射＋量測讀數青）。只做深色，刻意不跟系統淺色切換。 */
        --bg: #0D0F12;
        --surface: #14171C;
        --text: #ECE8E1;
        --muted: #A2A8AF;
        --laser: #FF4A2E;      /* 線雷射紅：主要按鈕與重點 */
        --read: #7FE0D3;       /* 量測讀數青：連結與狀態 */
        --brand: #FF6A50;
        --brand-dark: #FF8A74; /* 舊樣式沿用的「品牌色」，深底上改成亮一點的雷射紅 */
        --line: #FF4A2E;       /* LINE 按鈕改用雷射紅，文字保留「加 LINE」 */
        --border: rgba(236, 232, 225, .12);
        --shadow: 0 10px 30px rgba(0, 0, 0, .45);
        --f-body: "Noto Sans TC", -apple-system, "Segoe UI", "PingFang TC", "Microsoft JhengHei", sans-serif;
        --f-mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, Consolas, monospace;
        --f-num: "Big Shoulders Display", "Bahnschrift", "DIN Condensed", sans-serif;
        color-scheme: dark;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        font-family: var(--f-body);
        background: var(--bg);
        color: var(--text);
        line-height: 1.8;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }
      a { color: inherit; }
      img { max-width: 100%; }
      :focus-visible { outline: 2px solid var(--laser); outline-offset: 3px; }
      .mono { font-family: var(--f-mono); }
      .wrap { max-width: 720px; margin: 0 auto; padding: 0 max(20px, env(safe-area-inset-right, 0px)) 0 max(20px, env(safe-area-inset-left, 0px)); }
      /* 電腦版放寬：列表、卡片、首頁用 1120px；長文維持 .wrap 680px 方便閱讀 */
      .wrap-wide { max-width: 1240px; margin: 0 auto; padding: 0 max(20px, env(safe-area-inset-right, 0px)) 0 max(20px, env(safe-area-inset-left, 0px)); }
      .grid-2 { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
      .grid-3 { display: grid; gap: 20px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); }
      section { padding: 56px 0; }
      h1 { font-size: 2rem; line-height: 1.3; letter-spacing: -0.01em; }
      h2 { font-size: 1.35rem; margin-bottom: 24px; }
      p { color: var(--muted); }
      .brand-tag { color: var(--brand-dark); font-weight: 700; letter-spacing: 0.05em; }

      /* 按鈕 */
      .btn {
        display: inline-flex; align-items: center; gap: 8px;
        min-height: 46px; padding: 0 22px; border-radius: 2px;
        font-weight: 600; font-size: .98rem; text-decoration: none;
        transition: transform .15s ease, box-shadow .15s ease;
      }
      .btn:hover { transform: translateY(-2px); }
      .btn-line { background: var(--laser); color: #160806; }
      .btn-line:hover { background: #ff6a52; }
      .btn-ghost { background: transparent; color: var(--text); border: 1px solid var(--border); }
      .btn-ghost:hover { border-color: var(--text); }

      /* Hero */
      .hero { padding-top: 80px; text-align: center; }
      .hero .avatar {
        width: 96px; height: 96px; border-radius: 50%;
        object-fit: cover; object-position: center 20%;
        margin: 0 auto 24px; display: block;
        border: 1px solid var(--border);
      }
      .hero p.lead { font-size: 1.1rem; margin: 16px 0 32px; }
      .hero h1 .h1-kicker { display: block; font-size: 1rem; color: var(--brand-dark); letter-spacing: .05em; margin-bottom: 12px; }

      /* 服務卡片 */
      .cards { display: grid; gap: 16px; }
      .card {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 2px; padding: 24px;
      }
      .card .num { color: var(--brand-dark); font-weight: 700; font-size: .9rem; }
      .card h3 { font-size: 1.1rem; margin: 6px 0 8px; }
      .card p { font-size: 1rem; }

      /* 分區標籤與進階區 */
      .zone-label {
        display: inline-block; color: var(--laser); font-family: var(--f-mono); font-weight: 500;
        font-size: .74rem; letter-spacing: .14em; margin-bottom: 6px;
      }
      .zone-intro { margin-bottom: 20px; }
      .zone-intro strong { color: var(--text); }
      .pill-list { list-style: none; display: grid; gap: 12px; }
      .pill-list li {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 12px; padding: 16px 20px; color: var(--text);
        font-weight: 600; font-size: .98rem;
      }
      .zone-note { margin-top: 20px; font-size: 1rem; }

      /* 見證 */
      .quote {
        background: var(--surface); border-left: 4px solid var(--brand);
        border-radius: 8px; padding: 20px 24px; margin-bottom: 16px;
      }
      .quote p { color: var(--text); font-style: italic; }
      .quote .who { color: var(--muted); font-size: .85rem; font-style: normal; margin-top: 8px; }

      /* 內容連結 */
      .posts a {
        display: block; padding: 16px 0; border-bottom: 1px solid var(--border);
        color: var(--text); text-decoration: none;
      }
      .posts a:hover { color: var(--brand-dark); }
      .posts .date { color: var(--muted); font-size: .85rem; }

      /* CTA 區塊 */
      .cta { text-align: center; background: linear-gradient(120deg, rgba(255,74,46,.12), transparent 55%), var(--surface); border: 1px solid var(--border); border-radius: 2px; margin: 40px 0; padding: 48px 24px; }
      .cta h2 { margin-bottom: 12px; }
      .cta p { margin-bottom: 28px; }

      footer { text-align: center; padding: 40px 0 calc(40px + env(safe-area-inset-bottom, 0px)); color: var(--muted); font-size: .85rem; border-top: 1px solid var(--border); margin-top: 40px; }
      footer a { color: var(--muted); }

      /* 文章內文 */
      .prose { max-width: 680px; }
      .prose h2 { font-size: 1.5rem; margin: 40px 0 16px; }
      .prose h3 { font-size: 1.2rem; margin: 32px 0 12px; }
      .prose p { color: var(--text); margin-bottom: 20px; }
      .prose ul, .prose ol { color: var(--text); margin: 0 0 20px 1.4em; }
      .prose li { margin-bottom: 8px; }
      .prose a { color: var(--read); }
      .prose blockquote {
        border-left: 4px solid var(--brand); background: var(--surface);
        padding: 16px 20px; border-radius: 8px; margin: 0 0 20px;
      }
      .prose img { max-width: 100%; border-radius: 12px; }

      /* 通用 meta 行、麵包屑、標籤 */
      .post-meta { color: var(--muted); font-size: .9rem; margin-bottom: 8px; }
      .tag { display: inline-block; color: var(--brand-dark); font-size: .85rem; margin-right: 8px; }
      .compliance-note {
        background: var(--surface); border: 1px solid var(--border);
        border-radius: 8px; padding: 12px 16px; font-size: .85rem;
        color: var(--muted); margin-bottom: 24px;
      }
      .back-link { display: inline-block; margin-top: 8px; color: var(--brand-dark); text-decoration: none; font-weight: 600; }

      /* 內頁導覽與頁首（服務／作品／筆記） */
      .site-nav { position: sticky; top: env(safe-area-inset-top, 0px); z-index: 10; background: rgba(13,15,18,.86); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); border-bottom: 1px solid var(--border); display: flex; align-items: center; justify-content: space-between; gap: 12px; padding-top: 20px; padding-bottom: 12px; flex-wrap: wrap; }
      .site-nav-brand { color: var(--text); font-weight: 700; text-decoration: none; }
      .site-nav ul { list-style: none; display: flex; gap: 18px; }
      .site-nav a { color: var(--muted); text-decoration: none; font-weight: 600; font-size: .95rem; }
      .site-nav a[aria-current="page"], .site-nav a:hover { color: var(--text); }
      .site-nav a[aria-current="page"] { box-shadow: inset 0 -2px 0 var(--laser); }
      .page-head { padding-top: 40px; padding-bottom: 24px; }
      .page-head h1 { margin: 6px 0 12px; }
      .page-head .lead { font-size: 1.05rem; }
      .card-link { display: block; text-decoration: none; color: inherit; transition: transform .15s ease, box-shadow .15s ease; }
      .card-link:hover { transform: translateY(-2px); border-color: var(--laser); }
      .card-link h3 { color: var(--text); }
      .card-cover { width: 100%; height: auto; border-radius: 2px; margin-bottom: 14px; display: block; }
      .work-facts { background: var(--surface); border: 1px solid var(--border); border-radius: 12px; padding: 14px 18px; margin-bottom: 28px; }
      .work-facts p { margin: 4px 0 !important; font-size: .95rem; }
      .work-facts strong { color: var(--text); }
      .prose pre { background: #07090B; border: 1px solid var(--border); color: #ECE8E1; padding: 16px 18px; border-radius: 10px; overflow-x: auto; margin: 0 0 20px; font-size: .88rem; line-height: 1.55; }
      .prose code { font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace; font-size: .92em; }
      .prose :not(pre) > code { background: var(--surface); border: 1px solid var(--border); padding: 1px 6px; border-radius: 6px; }
      .prose table { width: 100%; border-collapse: collapse; margin: 0 0 20px; font-size: .95rem; display: block; overflow-x: auto; }
      .prose th, .prose td { border: 1px solid var(--border); padding: 8px 12px; text-align: left; color: var(--text); vertical-align: top; }
      .prose th { background: var(--surface); }
      .home-more { display: grid; gap: 12px; }
      /* 作品卡片（首頁精選與 /works/ 列表共用） */
      .works-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; }
      .w { background: var(--surface); border: 1px solid var(--border); display: grid; grid-template-rows: auto 1fr; text-decoration: none; color: var(--text); min-width: 0; transition: border-color .2s; }
      .w:hover { border-color: var(--laser); }
      .w-img { aspect-ratio: 16 / 10; max-width: 100%; overflow: hidden; position: relative; background: #1b1f26; }
      .w-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .6s ease; }
      .w:hover .w-img img { transform: scale(1.04); }
      .w-kind { position: absolute; left: 12px; top: 12px; font-size: .68rem; letter-spacing: .1em; background: rgba(13, 15, 18, .82); padding: 3px 8px; color: var(--text); }
      .w-txt { padding: 20px 22px 24px; display: grid; gap: 8px; align-content: start; }
      .w-txt h3 { font-size: 1.1rem; }
      .w-txt p { font-size: .9rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
      .w-stack { font-size: .7rem; color: var(--read); letter-spacing: .04em; }
      @media (max-width: 1000px) { .works-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 640px) { .works-grid { grid-template-columns: minmax(0, 1fr); } }
      /* 作品／筆記內頁：儀器風頁首 */
      .entry h1 { font-size: clamp(1.7rem, 3.6vw, 2.4rem); line-height: 1.3; margin: 4px 0 14px; }
      .entry-meta { display: flex; flex-wrap: wrap; gap: 6px 16px; font-size: .78rem; letter-spacing: .06em; color: var(--muted); margin-bottom: 28px; }
      .entry-meta .on { color: var(--read); }
      .entry-cover { position: relative; margin: 0 0 24px; border: 1px solid var(--border); background: #1b1f26; aspect-ratio: 16 / 10; overflow: hidden; }
      .entry-cover img { width: 100%; height: 100%; object-fit: cover; display: block; border-radius: 0 !important; }
      .entry-cover::before, .entry-cover::after { content: ""; position: absolute; width: 18px; height: 18px; border: 2px solid var(--laser); z-index: 1; pointer-events: none; }
      .entry-cover::before { left: 8px; top: 8px; border-right: 0; border-bottom: 0; }
      .entry-cover::after { right: 8px; bottom: 8px; border-left: 0; border-top: 0; }
      .entry-facts { display: grid; gap: 1px; background: var(--border); border: 1px solid var(--border); margin: 0 0 32px; }
      .entry-facts div { background: var(--surface); padding: 12px 16px; display: grid; gap: 2px; }
      .entry-facts dt { font-size: .68rem; letter-spacing: .14em; color: var(--laser); }
      .entry-facts dd { margin: 0; font-size: .85rem; color: var(--text); }
      .entry-facts a { color: var(--read); text-decoration: none; }
      /* 品牌網站 Demo：作品頁直接嵌入整個網站 */
      .demo-view { padding: 0 0 24px; }
      .demo-bar { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px 28px; flex-wrap: wrap; padding-top: 22px; padding-bottom: 18px; }
      .demo-id { display: grid; gap: 4px; max-width: 46rem; min-width: 0; }
      .demo-id h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.2; }
      .demo-id p { font-size: .92rem; }
      .demo-actions { display: flex; gap: 10px; flex-wrap: wrap; }
      .demo-frame { margin: 0 max(12px, env(safe-area-inset-left, 0px)); border: 1px solid var(--border); background: #000; box-shadow: 0 0 0 1px rgba(255,74,46,.15), var(--shadow); }
      .demo-dots { display: flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; background: var(--surface); border-bottom: 1px solid var(--border); }
      .demo-dots i { width: 8px; height: 8px; border-radius: 50%; background: #3a3f47; }
      .demo-dots i:first-child { background: var(--laser); }
      .demo-dots em { font-style: normal; font-size: .7rem; color: var(--muted); margin-left: 10px; letter-spacing: .04em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .demo-frame iframe { display: block; width: 100%; height: calc(100svh - 208px); min-height: 460px; border: 0; background: #fff; }
      .demo-note { font-size: .78rem; color: var(--muted); padding-top: 14px; }
      .demo-note a { color: var(--read); margin-left: 8px; white-space: nowrap; }
      @media (max-width: 640px) { .demo-actions .btn { min-height: 40px; padding: 0 14px; font-size: .9rem; } .demo-frame { margin: 0; border-left: 0; border-right: 0; } .demo-frame iframe { height: calc(100svh - 252px); } }
    </style>
  </head>
  <body>
    <slot />

    <footer class="wrap-wide">
      <nav aria-label="網站導覽" style="margin-bottom:12px;">
        <a href="/">首頁</a> · <a href="/services/">服務</a> · <a href="/works/">作品</a> · <a href="/notes/">技術筆記</a> · <a href="https://tedshen.link/">身分頁</a> · <a href="https://grow.tedshen.link/">財務教練</a>
      </nav>
      <p>Ted ｜ 軟體開發 · dev.tedshen.link</p>
      <p style="margin-top:8px;">聯絡：<a href={`mailto:${EMAIL}`}>{EMAIL}</a></p>
    </footer>
  </body>
</html>
